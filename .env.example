# Copy to .env (git-ignored) and fill in. Used only by the optional Addis AI reference proxy
# (docker compose --profile addis up). On Vercel, set ADDIS_API_KEY in Project Settings > Environment Variables.
ADDIS_API_KEY=
# Optional: extra page origins allowed to use the proxy (comma-separated). The proxy's own host is always allowed.
# ALLOWED_ORIGINS=https://savanna-accessible-onboarding.vercel.app,http://localhost:8080
